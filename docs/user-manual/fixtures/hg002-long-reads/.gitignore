# Scratch downloads and intermediate BAMs from fetch.sh.
cache/

# regenerate.sh output: only the primary assembly FASTA from each
# assembler is committed (the Flye and hifiasm working directories
# otherwise carry repeat graphs, logs, and phased/unitig GFAs not needed
# by the fixture). Reproducible by running regenerate.sh.
expected/flye/*
!expected/flye/assembly.fasta
expected/hifiasm/*
!expected/hifiasm/contigs.fasta
