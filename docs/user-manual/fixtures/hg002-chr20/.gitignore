# Scratch downloads and intermediate BAMs from fetch.sh.
cache/

# regenerate.sh output: HG002.sorted.bam is ~13 MB, over the 10 MB
# per-file fixture cap. Reproducible by running regenerate.sh.
# The two caller VCFs under expected/variants/ are tiny and are committed
# so the manual's quoted rows live in the repo. Their provenance sidecars
# carry machine paths and stay out.
expected/*
!expected/variants/
expected/variants/*
!expected/variants/bcftools/
!expected/variants/lofreq/
expected/variants/*/*
!expected/variants/*/*.vcf.gz
!expected/variants/*/*.vcf.gz.tbi
